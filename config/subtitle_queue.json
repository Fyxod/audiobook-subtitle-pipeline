  ],
  "editor": {
    "script": "scripts/reconcile_transcripts_vllm.py",
    "model": "nemotron-49b-v1_5",
    "base_url_env": "EDITOR_BASE_URL"
  },
  "runtime": {
    "qwen_batch_size": 2,
    "whisper_batch_size": 2,
    "whisper_input_group_size": 1
  }
}

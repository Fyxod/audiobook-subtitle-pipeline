{
  "description": "Example batch for chaptered long-form audio",
  "jobs": [
    {
      "id": "sample_book",
      "source": "source/sample_book.m4b",
      "work_dir": "work/sample_book",
      "output_dir": "output/sample_book",
      "output_basename": "sample_book",
      "glossary_file": null
